<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¡RESERVA CONFIRMADA!"
        android:textAlignment="center"
        android:textColor="#003366"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="5dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comprobante Digital de Reserva"
        android:textAlignment="center"
        android:textColor="#757575"
        android:textSize="14sp"
        android:layout_marginBottom="25dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="4dp"
        android:layout_marginBottom="30dp">

        <TextView
            android:id="@+id/tvReciboHabitacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Habitación: "
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvReciboHuesped"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Huésped: "
            android:textColor="#555555"
            android:textSize="15sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvReciboContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contacto: "
            android:textColor="#555555"
            android:textSize="15sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvReciboPersonas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Número de Personas: "
            android:textColor="#555555"
            android:textSize="15sp"
            android:layout_marginBottom="15dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:id="@+id/tvReciboTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total:"
            android:textColor="#003366"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnVolverInicio"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Volver al Inicio"
        android:backgroundTint="#003366"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>

</LinearLayout>